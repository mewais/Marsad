# Rust
/target
**/target
Cargo.lock.bak

# Nested sibling projects, kept as their OWN independent git repos inside this
# working tree so they are in-ceiling for editing, but NEVER tracked by Marsad
# (single source of truth per repo). Wasl = A2A/multi-agent runtime; Wasit =
# the shared CLI-driver library both Wasl and Marsad depend on.
/Wasl/
/Wasit/

# Local cargo registry cache (machine-specific; never commit)
.cargo-cache/
.cargo/

# Project-local dev tools (e.g. cargo-llvm-cov) installed because the global
# cargo bin dir is read-only in this environment. Machine-specific; never commit.
.tools/

# Node / desktop UI
node_modules/
apps/desktop/dist/
apps/desktop/.vite/
*.tsbuildinfo

# Tauri
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/gen/

# iOS
apps/ios/build/
apps/ios/*.xcodeproj/
apps/ios/DerivedData/
*.xcuserstate

# Android
apps/android/.gradle/
apps/android/build/
apps/android/app/build/
apps/android/local.properties

# Coverage
*.profraw
*.profdata
/coverage/
lcov.info

# Fixtures captured locally that are too large / machine-specific go here;
# the curated, checked-in fixtures live under fixtures/streams and fixtures/hooks.
fixtures/_local/

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# The design handoff bundle is reference-only, not part of the repo source.
_extracted/
*.zip

# Design reference PNGs — local only, never commit
design_samples/

# Tauri sidecar staging (built locally by stage-sidecars)
apps/desktop/src-tauri/binaries/
.claude/worktrees/
apps/desktop/test-results/
