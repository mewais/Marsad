{
  "name": "marsad-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "author": "Mohammad Ewais <mohammad.a.ewais@gmail.com>",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "node --disable-wasm-trap-handler node_modules/vitest/vitest.mjs run --config vitest.config.ts",
    "test:watch": "node --disable-wasm-trap-handler node_modules/vitest/vitest.mjs --config vitest.config.ts",
    "test:e2e": "playwright test --trace off",
    "test:real": "xvfb-run -a -s '-screen 0 1600x1000x24' dbus-run-session node e2e-real/run.mjs",
    "tauri": "tauri",
    "stage-sidecars": "node scripts/stage-sidecars.mjs",
    "bundle": "node scripts/stage-sidecars.mjs && tauri build --config src-tauri/tauri.bundle.conf.json",
    "bundle:win": "node scripts/stage-sidecars.mjs --target x86_64-pc-windows-msvc && tauri build --config src-tauri/tauri.bundle.conf.json --runner cargo-xwin --target x86_64-pc-windows-msvc --bundles nsis",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tauri-apps/api": "~2.12.5",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "5.5.0",
    "elkjs": "0.9.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@tauri-apps/cli": "^2.12.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "happy-dom": "^20.10.6",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.8",
    "vitest": "^2.1.2"
  }
}
