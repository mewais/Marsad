{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Marsad",
  "version": "0.2.0",
  "identifier": "com.mewais.marsad",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Marsad — مرصد",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "label": "main",
        "transparent": true,
        "windowEffects": {
          "effects": [
            "acrylic",
            "blur"
          ]
        }
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "installer-hooks.nsh"
      }
    }
  }
}
